# Alpaca PAPER credentials only. Never commit your real .env file.
ALPACA_API_KEY=your_paper_key
ALPACA_SECRET_KEY=your_paper_secret
ALPACA_PAPER=true

# -------------------------------------------------------------------
# LIVE A/B EXPERIMENT RISK
# -------------------------------------------------------------------
# The live engine reads the actual Alpaca paper equity when Start Session
# is pressed and freezes a 50/50 allocation for Model A and Model B.
# Example: $83,420 account -> $41,710 per model for that trading day.
#
# Dollar limits below are therefore percentage-based and scale automatically.
RISK_PER_TRADE_PCT=0.005
MAX_POSITION_PCT=0.25
DAILY_LOSS_PCT=0.02
MAX_ACCOUNT_EXPOSURE_PCT=0.50
MAX_TRADES_PER_DAY=6
MAX_CONSECUTIVE_LOSSES=2

# Exit management
STOP_LOSS_PCT=0.025
TAKE_PROFIT_PCT=0.05
TRAIL_TRIGGER_PCT=0.03
TRAIL_DISTANCE_PCT=0.015

# Model A - control
RELATIVE_VOLUME_MIN=1.5

# Model B - momentum/catalyst challenger
MOMENTUM_RVOL_MIN=2.0
MOMENTUM_GAP_MIN_PCT=4.0
MOMENTUM_CHANGE_MIN_PCT=5.0
MOMENTUM_MAX_PRICE=30
MOMENTUM_REQUIRE_NEWS=true

# Engine / logging
POLL_SECONDS=10
TRADE_LOG_DIR=trade-data

# Dynamic universe
DYNAMIC_UNIVERSE=true
UNIVERSE_REFRESH_MINUTES=10
UNIVERSE_SIZE=150
SNAPSHOT_BATCH_SIZE=200
BAR_BATCH_SIZE=20
MIN_PRICE=1
MIN_DOLLAR_VOLUME=1000000
MAX_SPREAD_PCT=0.01
EXCLUDED_SYMBOLS=

# -------------------------------------------------------------------
# HISTORICAL BACKTEST / COMPATIBILITY ONLY
# These do NOT control the live 50/50 split.
# -------------------------------------------------------------------
STARTING_BALANCE=100000
MODEL_CAPITAL=50000
TARGET_EQUITY=150000
FLOOR_EQUITY=50000
MAX_EXPOSURE=50000
RISK_PER_TRADE=250
MAX_POSITION_NOTIONAL=12500
DAILY_LOSS_LIMIT=1000
WATCHLIST=SPY,QQQ,NVDA,TSLA,AMD,PLTR,AAPL,META,AMZN,MSFT
