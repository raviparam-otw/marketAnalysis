# Alpaca PAPER credentials only. Never commit your real .env file.
ALPACA_API_KEY=your_paper_key
ALPACA_SECRET_KEY=your_paper_secret
ALPACA_PAPER=true
ACTION_DAY_MODE=true

# -------------------------------------------------------------------
# LIVE A/B EXPERIMENT RISK
# -------------------------------------------------------------------
# The live engine reads the actual Alpaca paper equity when Start Session
# is pressed and freezes a 50/50 allocation for Model A and Model B.
# Example: $83,420 account -> $41,710 per model for that trading day.
#
# Dollar limits below are therefore percentage-based and scale automatically.
RISK_PER_TRADE_PCT=0.005
MAX_POSITION_PCT=0.25
DAILY_LOSS_PCT=0.02
MAX_ACCOUNT_EXPOSURE_PCT=0.80
MAX_TRADES_PER_DAY=6
MAX_CONSECUTIVE_LOSSES=2

# Model A control profile
MODEL_A_MAX_OPEN_POSITIONS=3
MODEL_A_MAX_EXPOSURE_PCT=0.65

# Model B action-day profile (PAPER ONLY)
MODEL_B_RISK_PER_TRADE_PCT=0.01
MODEL_B_MAX_POSITION_PCT=0.20
MODEL_B_DAILY_LOSS_PCT=0.05
MODEL_B_MAX_TRADES_PER_DAY=20
MODEL_B_MAX_CONSECUTIVE_LOSSES=5
MODEL_B_MAX_OPEN_POSITIONS=5
MODEL_B_MAX_EXPOSURE_PCT=0.90
MODEL_B_MAX_ENTRIES_PER_CYCLE=3

# Exit management
STOP_LOSS_PCT=0.025
TAKE_PROFIT_PCT=0.05
TRAIL_TRIGGER_PCT=0.03
TRAIL_DISTANCE_PCT=0.015
BREAK_EVEN_TRIGGER_PCT=0.0075
BREAK_EVEN_LOCK_PCT=0.001
EARLY_TRAIL_TRIGGER_PCT=0.01
EARLY_TRAIL_DISTANCE_PCT=0.006
STAGNATION_MINUTES=45
STAGNATION_MIN_GAIN_PCT=0.005

# Model A - control
RELATIVE_VOLUME_MIN=1.5

# Model B - momentum/catalyst challenger
MOMENTUM_RVOL_MIN=1.25
MOMENTUM_GAP_MIN_PCT=1.5
MOMENTUM_CHANGE_MIN_PCT=2.0
MOMENTUM_MAX_PRICE=50
MOMENTUM_REQUIRE_NEWS=false
MOMENTUM_MIN_SCORE=5.0

# Model C - LLM multi-agent adaptive trader.
# Use any OpenAI-compatible endpoint serving an OPEN-SOURCE model:
#   Ollama example base URL: http://127.0.0.1:11434/v1
#   vLLM example base URL:   http://127.0.0.1:8001/v1
# A self-hosted FinGPT/finance-tuned model can be used behind the same interface.
MODEL_C_ENABLED=true
MODEL_C_EXECUTION_ENABLED=true
MODEL_C_LLM_BASE_URL=
MODEL_C_LLM_MODEL=
MODEL_C_LLM_API_KEY=
MODEL_C_LLM_TIMEOUT_SECONDS=30
MODEL_C_DECISION_INTERVAL_SECONDS=60
MODEL_C_SHORTLIST_SIZE=5
MODEL_C_MIN_CONFIDENCE=0.68

# Model C risk profile
MODEL_C_RISK_PER_TRADE_PCT=0.0075
MODEL_C_MAX_POSITION_PCT=0.25
MODEL_C_DAILY_LOSS_PCT=0.03
MODEL_C_MAX_TRADES_PER_DAY=10
MODEL_C_MAX_CONSECUTIVE_LOSSES=3
MODEL_C_MAX_OPEN_POSITIONS=3
MODEL_C_MAX_EXPOSURE_PCT=0.75

# Engine / logging
POLL_SECONDS=10
TRADE_LOG_DIR=trade-data

# Dynamic universe
DYNAMIC_UNIVERSE=true
UNIVERSE_REFRESH_MINUTES=10
UNIVERSE_SIZE=150
SNAPSHOT_BATCH_SIZE=200
BAR_BATCH_SIZE=20
MIN_PRICE=1
MIN_DOLLAR_VOLUME=1000000
MAX_SPREAD_PCT=0.01
EXCLUDED_SYMBOLS=

# -------------------------------------------------------------------
# HISTORICAL BACKTEST / COMPATIBILITY ONLY
# These do NOT control the live 50/50 split.
# -------------------------------------------------------------------
STARTING_BALANCE=100000
MODEL_CAPITAL=50000
TARGET_EQUITY=150000
FLOOR_EQUITY=50000
MAX_EXPOSURE=50000
RISK_PER_TRADE=250
MAX_POSITION_NOTIONAL=12500
DAILY_LOSS_LIMIT=1000
WATCHLIST=SPY,QQQ,NVDA,TSLA,AMD,PLTR,AAPL,META,AMZN,MSFT
