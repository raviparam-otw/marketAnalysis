# Alpaca PAPER credentials only. Never commit your real .env file.
ALPACA_API_KEY=your_paper_key
ALPACA_SECRET_KEY=your_paper_secret
ALPACA_PAPER=true
ACTION_DAY_MODE=true
ALPACA_DATA_FEED=iex

# -------------------------------------------------------------------
# LIVE A/C EXPERIMENT RISK
# -------------------------------------------------------------------
# The live engine reads the actual Alpaca paper equity when Start Session
# is pressed and freezes equal allocations for Models A and C.
# Example: ~$90,000 account -> ~$45,000 per model for that trading day.
#
# Dollar limits below are therefore percentage-based and scale automatically.
RISK_PER_TRADE_PCT=0.0075
MAX_POSITION_PCT=0.30
DAILY_LOSS_PCT=0.03
MAX_ACCOUNT_EXPOSURE_PCT=0.80
MAX_TRADES_PER_DAY=10
MAX_CONSECUTIVE_LOSSES=3

# Model A aggressive rules-based momentum profile
# Scans the dynamic universe and can hold several independent symbols.
# Entry/hold/exit settings favor confirmed structure over timer-based churn.
MODEL_A_MAX_OPEN_POSITIONS=4
MODEL_A_MAX_EXPOSURE_PCT=0.80
MODEL_A_WEAKNESS_EXIT_PCT=0.006
MODEL_A_FAILED_BREAKOUT_MINUTES=5
MODEL_A_FAILED_BREAKOUT_MAX_GAIN_PCT=0.003
MODEL_A_FAILED_BREAKOUT_EXIT_PCT=0.002
MODEL_A_BREAKOUT_BUFFER_PCT=0.0008
MODEL_A_CONFIRMATION_BARS=2
MODEL_A_MAX_EXTENSION_FROM_OR_PCT=0.03
MODEL_A_MAX_EXTENSION_FROM_VWAP_PCT=0.03
MODEL_A_MAX_BAR_AGE_SECONDS=120
MODEL_A_MAX_ENTRY_SPREAD_PCT=0.01
MODEL_A_MAX_ENTRY_SLIPPAGE_PCT=0.005
MODEL_A_QUOTE_MAX_AGE_SECONDS=5
MODEL_A_REENTRY_COOLDOWN_MINUTES=10
MODEL_A_REENTRY_MIN_BARS=5
MODEL_A_MIN_POSITION_PCT=0.02
MODEL_A_STRUCTURE_CONFIRM_BARS=2
MODEL_A_STRUCTURE_BREAK_PCT=0.001
MODEL_A_PROFIT_LOCK_TRIGGER_PCT=0.0075
MODEL_A_PROFIT_LOCK_PCT=0.003
MODEL_A_MAX_ENTRIES_PER_SYMBOL=3
MODEL_A_ENTRY_TIMEOUT_SECONDS=20

# Exit management
STOP_LOSS_PCT=0.025
TAKE_PROFIT_PCT=0.05
TRAIL_TRIGGER_PCT=0.03
TRAIL_DISTANCE_PCT=0.015
BREAK_EVEN_TRIGGER_PCT=0.0075
BREAK_EVEN_LOCK_PCT=0.001
EARLY_TRAIL_TRIGGER_PCT=0.01
EARLY_TRAIL_DISTANCE_PCT=0.006
STAGNATION_MINUTES=45
STAGNATION_MIN_GAIN_PCT=0.005

# Model A - aggressive momentum threshold
RELATIVE_VOLUME_MIN=1.25

# Model C - finance-native adaptive stack:
#   Fin-R1 7B = primary financial reasoning / portfolio manager
#   Kronos-small = short-horizon K-line forecast
#   ProsusAI/finbert = headline sentiment
#
# macOS setup:
#   ./scripts/setup_model_c_macos.sh
#   ./scripts/start_finr1_macos.sh
MODEL_C_ENABLED=true
MODEL_C_EXECUTION_ENABLED=true
MODEL_C_REQUIRE_FULL_STACK=false

# Fin-R1 OpenAI-compatible MLX endpoint
MODEL_C_LLM_BASE_URL=http://127.0.0.1:8080/v1
MODEL_C_LLM_MODEL=.models/Fin-R1-4bit
MODEL_C_LLM_API_KEY=
MODEL_C_LLM_TIMEOUT_SECONDS=60
MODEL_C_DECISION_INTERVAL_SECONDS=30
MODEL_C_SHORTLIST_SIZE=8
MODEL_C_MIN_CONFIDENCE=0.70

# FinBERT local sentiment
MODEL_C_FINBERT_ENABLED=true
MODEL_C_FINBERT_MODEL=ProsusAI/finbert

# Kronos local K-line forecaster
MODEL_C_KRONOS_ENABLED=true
MODEL_C_KRONOS_REPO_PATH=.models/Kronos
MODEL_C_KRONOS_MODEL=NeoQuasar/Kronos-small
MODEL_C_KRONOS_TOKENIZER=NeoQuasar/Kronos-Tokenizer-base
MODEL_C_KRONOS_DEVICE=cpu
MODEL_C_KRONOS_LOOKBACK=120
MODEL_C_KRONOS_PRED_LEN=5

# Model C risk profile
MODEL_C_RISK_PER_TRADE_PCT=0.0075
MODEL_C_MAX_POSITION_PCT=0.30
MODEL_C_DAILY_LOSS_PCT=0.035
MODEL_C_MAX_TRADES_PER_DAY=12
MODEL_C_MAX_CONSECUTIVE_LOSSES=3
MODEL_C_MAX_OPEN_POSITIONS=4
MODEL_C_MAX_EXPOSURE_PCT=0.80

# Model C deterministic execution validator.
# Fin-R1 is free to be aggressive, but orders must still agree with raw market facts.
MODEL_C_MIN_RVOL=1.25
MODEL_C_REQUIRE_POSITIVE_1M=true
MODEL_C_REQUIRE_VWAP_OR_POSITIVE_5M=true
MODEL_C_MAX_DISTANCE_FROM_HOD_PCT=5.0
MODEL_C_MAX_EXTENSION_FROM_VWAP_PCT=0.08

# Engine / logging
POLL_SECONDS=10
TRADE_LOG_DIR=trade-data

# Dynamic universe
DYNAMIC_UNIVERSE=true
UNIVERSE_REFRESH_MINUTES=10
UNIVERSE_SIZE=150
SNAPSHOT_BATCH_SIZE=200
BAR_BATCH_SIZE=20
MIN_PRICE=1
MIN_DOLLAR_VOLUME=1000000
MAX_SPREAD_PCT=0.01
EXCLUDED_SYMBOLS=

# -------------------------------------------------------------------
# HISTORICAL BACKTEST / COMPATIBILITY ONLY
# These do NOT control the live A/C split.
# -------------------------------------------------------------------
STARTING_BALANCE=100000
MODEL_CAPITAL=50000
TARGET_EQUITY=150000
FLOOR_EQUITY=50000
MAX_EXPOSURE=50000
RISK_PER_TRADE=250
MAX_POSITION_NOTIONAL=12500
DAILY_LOSS_LIMIT=1000
WATCHLIST=SPY,QQQ,NVDA,TSLA,AMD,PLTR,AAPL,META,AMZN,MSFT
