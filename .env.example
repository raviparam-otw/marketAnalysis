# Alpaca PAPER credentials only. Never commit your real .env file.
ALPACA_API_KEY=your_paper_key
ALPACA_SECRET_KEY=your_paper_secret
ALPACA_PAPER=true

# Experiment controls
STARTING_BALANCE=100000
TARGET_EQUITY=150000
FLOOR_EQUITY=50000
MAX_EXPOSURE=100000
DAILY_LOSS_LIMIT=5000
STOP_LOSS_PCT=0.025
TAKE_PROFIT_PCT=0.05
TRAIL_TRIGGER_PCT=0.03
TRAIL_DISTANCE_PCT=0.015
RELATIVE_VOLUME_MIN=1.5
POLL_SECONDS=60

# Dynamic live universe: every active Alpaca US equity is metadata-filtered,
# snapshot-screened, and ranked. The minute strategy scans the top results.
DYNAMIC_UNIVERSE=true
UNIVERSE_REFRESH_MINUTES=30
UNIVERSE_SIZE=100
SNAPSHOT_BATCH_SIZE=200
BAR_BATCH_SIZE=20
MIN_PRICE=5
MIN_DOLLAR_VOLUME=1000000
MAX_SPREAD_PCT=0.005
EXCLUDED_SYMBOLS=

# Used by the historical backtest and as the live fallback if dynamic discovery fails.
WATCHLIST=SPY,QQQ,NVDA,TSLA,AMD,PLTR,AAPL,META,AMZN,MSFT
